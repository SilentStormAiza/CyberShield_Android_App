<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BAD7E2"
    android:padding="20dp"
    tools:context=".Auth.signup">

    <!-- 1. SCROLLABLE CONTENT (Inputs) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomSection"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Create Account"
                android:textColor="#112C50"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Name Input -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="30dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Full Name"
                android:padding="12dp" />

            <!-- Email Input -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:padding="12dp" />

            <!-- Password Input -->
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="12dp" />

            <!-- Phone Number Input -->
            <EditText
                android:id="@+id/etPassword2"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Phone Number"
                android:inputType="phone"
                android:padding="12dp" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Who you are?"
                android:textAlignment="textStart"
                android:textColor="#132933"
                android:textStyle="italic" />

            <RadioGroup
                android:id="@+id/userTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/pub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Public User"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/tech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Technical Team Member" />

                <RadioButton
                    android:id="@+id/govt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Government Member(Crime Department)" />

            </RadioGroup>

            <Button
                android:id="@+id/signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Signup" />

        </LinearLayout>
    </ScrollView>

    <!-- 2. BOTTOM SECTION (Fixed at the bottom) -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="282dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView8"
            android:layout_width="174dp"
            android:layout_height="31dp"
            android:layout_gravity="center_vertical"
            android:text="Already have an account?"
            android:textColor="#415964" />

        <Button
            android:id="@+id/signlogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Login" />
    </LinearLayout>

</RelativeLayout>