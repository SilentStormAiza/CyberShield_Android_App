<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BAD7E2"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    tools:context=".Auth.Login">

    <EditText
        android:id="@+id/editTextTextPassword"
        style="@style/Widget.AppCompat.EditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="360dp"
        android:ems="10"
        android:hint="Enter Password"
        android:inputType="textPassword"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button2"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="189dp"
        android:layout_height="53dp"
        android:layout_marginEnd="108dp"
        android:layout_marginBottom="120dp"
        android:foregroundTint="#F4F5F8"
        android:text="Register"
        android:textColor="#EDEEF2"
        app:iconTint="#0D1333"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="179dp"
        android:layout_height="166dp"
        android:layout_marginEnd="108dp"
        android:layout_marginBottom="504dp"
        android:background="#081621"
        android:drawingCacheQuality="auto"
        android:fadingEdge="horizontal|vertical|none"
        android:fadingEdgeLength="600dp"
        android:focusable="auto"
        android:paddingLeft="7dp"
        android:paddingTop="7dp"
        android:paddingRight="7dp"
        android:paddingBottom="7dp"
        app:barrierMargin="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/vect" />

    <Button
        android:id="@+id/button3"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="185dp"
        android:layout_height="53dp"
        android:layout_marginEnd="112dp"
        android:layout_marginBottom="200dp"
        android:text="Login"
        android:textColorLink="#111942"
        app:cornerRadius="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="123dp"
        android:layout_height="29dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="304dp"
        android:text="Forget Password?"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="416dp"
        android:ems="10"
        android:hint="Enter Email Address"
        android:inputType="textEmailAddress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView24"
        android:layout_width="109dp"
        android:layout_height="25dp"
        android:layout_marginEnd="132dp"
        android:layout_marginBottom="528dp"
        android:fontFamily="monospace"
        android:text="CyberShield"
        android:textColor="#85B7DE"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>